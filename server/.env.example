# Copy to .env and fill in. Never commit .env.

# Postgres connection (VPS local socket or host)
DATABASE_URL=postgres://alyx:CHANGE_ME@localhost:5432/alyx_portfolio
# Dev (docker-compose.yml at repo root): pgvector image, loopback only. Matches the
# compose defaults; override with the same POSTGRES_* vars if you change them.
# DATABASE_URL=postgres://alyx:alyx_dev_pw@127.0.0.1:5432/alyx_portfolio

# JWT signing secret — use a long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Seed admin credentials (used once by `npm run seed`)
ADMIN_EMAIL=alivenata@gmail.com
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# HTTP port the API listens on (nginx proxies to this)
PORT=4000

# Comma-separated allowed origins for CORS (the sites that call this API)
CORS_ORIGINS=https://alyxlabs.tech,https://www.alyxlabs.tech,https://alyxdev.netlify.app,http://localhost:5173

# Public base URL of this API — used to build absolute image URLs for uploads
PUBLIC_URL=https://api.alyxlabs.tech

# Optional: pre-fill the admin Settings panel on first seed (editable later in-app).
# Leave blank to start empty. These are non-secret (a URL and a chat id).
CONTACT_ENDPOINT=
TELEGRAM_CHAT_ID=

# Optional: raises the GitHub sync rate limit (60/hr -> 5000/hr). README uses the
# rate-limit-free raw CDN and does not need this.
GITHUB_TOKEN=

# Frontend origin, used to build password verify/reset links in emails.
APP_URL=https://alyxlabs.tech

# Chatbot LLM proxy (was a Netlify function). Required for AI replies.
GROQ_API_KEY=
# On a Groq 429, retry once with this lighter model before giving up (P1-6).
# Set to a real model on your account (e.g. llama-3.1-8b-instant); empty disables the 429 fallback.
GROQ_FALLBACK_MODEL=

# Daily token budget per chat session (tokens_in+out). 0 or unset disables it. Placeholder - set your real cap.
BUDGET_TOKENS_PER_SESSION_DAY=30000
# Daily token budget per client IP (hashed). 0 or unset disables it. Placeholder - set your real cap.
BUDGET_TOKENS_PER_IP_DAY=80000
# CV-download Telegram notification (was a Netlify function). Bot token is secret;
# the destination chat id is set in admin Settings (or TELEGRAM_CHAT_ID below).
TELEGRAM_BOT_TOKEN=

# RAG retrieval for portfolio chat (P2-3). Retrieves RAG_TOP_K chunks per query.
# If the best cosine similarity (1 - distance) is below RAG_MIN_SIM, the bot
# answers "not sure" instead of guessing. Tune RAG_MIN_SIM from real data with
# `node scripts/rag-eval.js` before trusting the default.
RAG_TOP_K=5
# Lenient garbage-catch; the grounding prompt is the real not-sure gate. Tuned
# from rag-eval with the about-section excluded (on-topic tail min was 0.7715).
RAG_MIN_SIM=0.74
# Warm the embedding model at boot so the first portfolio visitor doesn't pay the
# one-time load (~412MB RSS, a few seconds). Off by default; set 1/true to enable.
EMBED_WARM_ON_BOOT=

# Shared server-side answer cache (P2-6). A grounded portfolio reply is stored and
# replayed for the same question from any visitor - no Groq call, no token budget
# spent on a hit. Entries expire after CACHE_TTL_DAYS; the table is trimmed to the
# newest CACHE_MAX_ROWS (oldest dropped first); a reindex clears it entirely. Only
# grounded portfolio answers are cached (never curhat/english/not-sure/fallback).
CACHE_TTL_DAYS=14
CACHE_MAX_ROWS=2000

# Chat logging IP/UA hash key (P1-1). Set a long random secret in prod (e.g.
# `openssl rand -hex 32`). If left blank, ip_hash/ua_hash are stored NULL.
LOG_HASH_SALT=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Lead-funnel anti-spam (P3-3). A second lead for the same session+channel within
# DEDUP_HOURS is treated as idempotent (no duplicate row). A hot lead sends one
# email to chatbot_settings.contact_email; a repeat hot lead for the same session
# within NOTIFY_DEDUP_MIN minutes does not send another. Both optional.
DEDUP_HOURS=24
NOTIFY_DEDUP_MIN=10

# Gmail SMTP for password verify/reset emails. SMTP_PASS is a Google App Password
# (16 chars, from myaccount.google.com/apppasswords) — NOT your login password.
# If left blank, links are printed to the server console instead (dev only).
SMTP_USER=alivenata@gmail.com
SMTP_PASS=
SMTP_FROM=Alyx Admin <alivenata@gmail.com>
