# Alyx-Website server environment. Copy to .env and fill in real values.
# Never commit the real .env. Placeholders below are examples, not secrets.

# --- Core ---
DATABASE_URL=postgres://user:password@localhost:5432/alyx_portfolio
PORT=4000
# Public origin used to build absolute /uploads URLs (page-1 CV teaser, etc).
PUBLIC_URL=http://localhost:4000
# App origin used in emails (password reset, verification links).
APP_URL=http://localhost:5173
# Comma-separated allowed origins for CORS.
CORS_ORIGINS=http://localhost:5173

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-on-first-seed

# --- AI chat (Groq) ---
GROQ_API_KEY=gsk_your_key_here
# Smaller model used as a 1-hop fallback when the budget 429s.
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
# Warm the local embedding model on boot (1) or lazy-load on first use (0).
EMBED_WARM_ON_BOOT=1
# RAG retrieval tuning.
RAG_TOP_K=5
RAG_MIN_SIM=0.74

# --- Token budget + semantic cache ---
BUDGET_TOKENS_PER_SESSION_DAY=30000
BUDGET_TOKENS_PER_IP_DAY=80000
CACHE_TTL_DAYS=14
CACHE_MAX_ROWS=2000

# --- Privacy logging ---
# HMAC salt for hashing IP / user agent in logs. If unset, hashes are null.
LOG_HASH_SALT=change-me-to-a-random-salt

# --- Email (SMTP) ---
# Used for password reset/verify, hot-lead notifications, contact + CV emails.
SMTP_USER=you@example.com
SMTP_PASS=your_smtp_app_password
SMTP_FROM=Alyx <you@example.com>

# --- Lead funnel notifications ---
# Minimum minutes between hot-lead notification emails (dedup).
NOTIFY_DEDUP_MIN=10
# Hours a (session, channel) lead is deduped before a new row is written.
DEDUP_HOURS=24

# --- Integrations (optional) ---
# GitHub token for the admin GitHub mirror panel (read-only scope is enough).
GITHUB_TOKEN=
# Telegram bot for CV-download notifications (optional).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Fallback Google Apps Script endpoint for the contact form (optional; the
# live value is usually set in the admin Settings instead).
CONTACT_ENDPOINT=
